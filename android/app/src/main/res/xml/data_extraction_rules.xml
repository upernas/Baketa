<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: qué se incluye en la copia en la nube y en la transferencia entre
     dispositivos. Solo ajustes y grooves guardados localmente. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
